rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function supportedRole(role) {
      return role in [
        'super_admin',
        'finance_verifier',
        'satker_head',
        'satker_head_loyalis',
        'employee_admin',
        'honorer',
        'loyalis',
        'loyalis_presence_admin',
        'ketua_shift_satpam'
      ];
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasActiveProfile() {
      // Some historical profiles predate the disabled flag. Treat a missing
      // flag as enabled while still denying explicitly disabled accounts.
      return signedIn() &&
        firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        ) &&
        profile().get('disabled', false) == false &&
        supportedRole(profile().role);
    }

    function roleIs(role) {
      return hasActiveProfile() && profile().role == role;
    }

    function isFinance() {
      return roleIs('super_admin') ||
        roleIs('finance_verifier');
    }

    function payrollPeriodOpen(period) {
      return period.matches('^\\d{4}-\\d{2}$') &&
        (
          !firestore.exists(
            /databases/(default)/documents/PayrollPeriods/$(period)
          ) ||
          firestore.get(
            /databases/(default)/documents/PayrollPeriods/$(period)
          ).data.get('attendanceStatus', 'open') != 'closed'
        );
    }

    function validReportFile() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(application/pdf|image/.*)');
    }

    // Payslips are written by the protected Admin API and served with
    // short-lived signed URLs. Direct client access is always denied.
    match /payslips/{allPaths=**} {
      allow read, write: if false;
    }

    match /vakasi_reports/{period}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        roleIs('satker_head_loyalis');
      allow create, update: if
        (isFinance() || roleIs('satker_head') || roleIs('satker_head_loyalis')) &&
        payrollPeriodOpen(period) &&
        validReportFile();
      allow delete: if false;
    }

    // One receipt per locked header item on an expense-mode LPJ report.
    match /expense_report_receipts/{reportId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head_loyalis');
      allow create, update: if
        (isFinance() || roleIs('satker_head_loyalis')) &&
        validReportFile();
      allow delete: if false;
    }

    match /presence_corrections/{employeeId}/{filename} {
      allow read: if isFinance() || roleIs('loyalis_presence_admin') ||
        (hasActiveProfile() && profile().linkedEmployeeId == employeeId);
      allow create, update: if
        (
          roleIs('loyalis_presence_admin') ||
          (hasActiveProfile() && profile().linkedEmployeeId == employeeId)
        ) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // One optional proof image can accompany a non-driver Pekarya SPJ. It is
    // scoped to the submitting employee before an ActivityReport exists.
    match /activity_proofs/{employeeId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == employeeId);
      allow create, update: if
        hasActiveProfile() &&
        profile().get('linkedEmployeeId', '') == employeeId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /receipts/{journeyId}/{filename} {
      function journeyExists() {
        return firestore.exists(
          /databases/(default)/documents/DriverJourneys/$(journeyId)
        );
      }

      function journey() {
        return firestore.get(
          /databases/(default)/documents/DriverJourneys/$(journeyId)
        ).data;
      }
      allow read: if journeyExists() &&
        (isFinance() || roleIs('satker_head') ||
          (hasActiveProfile() && journey().get('employeeId', '') == profile().get('linkedEmployeeId', '')));
      allow create, update: if
        journeyExists() &&
        payrollPeriodOpen(journey().get('payrollPeriod', journey().get('period', ''))) &&
        (isFinance() ||
          roleIs('satker_head') ||
          (hasActiveProfile() && journey().get('employeeId', '') == profile().get('linkedEmployeeId', ''))) &&
        request.resource.size < 5 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if false;
    }

    // Guard-post proof photos. Keyed by the uploading Ketua Shift because the
    // photos are taken while the shift form is still a draft, before the
    // ShiftOccurrence document exists. Kepala SatKer reads them to audit that
    // the pictured guard matches the assignment before releasing the fees.
    match /satpam_shifts/{ketuaShiftId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == ketuaShiftId);
      allow create, update: if
        hasActiveProfile() &&
        profile().get('linkedEmployeeId', '') == ketuaShiftId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

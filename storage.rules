rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for vakasi reports folder
    match /vakasi_reports/{period}/{filename} {
      // Allow any authenticated user (admins, satker heads, employees) to read and write reports
      allow read, write: if isAuthenticated();
    }
  }
}

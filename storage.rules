rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function supportedRole(role) {
      return role in [
        'super_admin',
        'finance_verifier',
        'satker_head',
        'satker_head_loyalis',
        'loyalis_admin',
        'honorer',
        'loyalis',
        'ketua_shift_satpam',
        // Retired ids merged into loyalis_admin; kept until every profile is
        // migrated (npm run migrate:loyalis-admin-role -- --apply).
        'employee_admin',
        'loyalis_presence_admin'
      ];
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasActiveProfile() {
      // Some historical profiles predate the disabled flag. Treat a missing
      // flag as enabled while still denying explicitly disabled accounts.
      return signedIn() &&
        firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        ) &&
        profile().get('disabled', false) == false &&
        supportedRole(profile().role);
    }

    function roleIs(role) {
      return hasActiveProfile() && profile().role == role;
    }

    // Employee master data plus Loyalis presence. The retired ids it replaced
    // still count until every profile is migrated.
    function isLoyalisAdmin() {
      return roleIs('loyalis_admin') || roleIs('employee_admin') ||
        roleIs('loyalis_presence_admin');
    }

    function isFinance() {
      return roleIs('super_admin') ||
        roleIs('finance_verifier');
    }

    // Payslips are written by the protected Admin API and served with
    // short-lived signed URLs. Direct client access is always denied.
    match /payslips/{allPaths=**} {
      allow read, write: if false;
    }

    // Writes below are server-only: Storage Rules' cross-service
    // firestore.get()/firestore.exists() calls (used by hasActiveProfile(),
    // isFinance(), payrollPeriodOpen(), etc.) do not reliably evaluate for
    // this project, which silently denied legitimate uploads that depended
    // on them. Role/ownership/period checks now happen server-side via the
    // Admin SDK in src/app/api/uploads/*/route.ts, which write through
    // src/lib/server/storageUpload.ts. `allow read` is left as documentation
    // of intended access — in practice viewers use the permanent
    // token-based download URL returned at upload time, which bypasses
    // these rules entirely, so its brokenness doesn't block reads.

    match /vakasi_reports/{period}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        roleIs('satker_head_loyalis');
      allow create, update: if false;
      allow delete: if false;
    }

    // One receipt per locked header item on an expense-mode LPJ report.
    match /expense_report_receipts/{reportId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head_loyalis');
      allow create, update: if false;
      allow delete: if false;
    }

    match /presence_corrections/{employeeId}/{filename} {
      allow read: if isFinance() || isLoyalisAdmin() ||
        (hasActiveProfile() && profile().linkedEmployeeId == employeeId);
      allow create, update: if false;
      allow delete: if false;
    }

    // Surat resmi (photo, scan or PDF) attached to a Loyalis ganti libur
    // request. Uploaded through /api/uploads/ganti-libur and read back by
    // the request API, which stores the token download URL on the request.
    match /ganti_libur/{employeeId}/{filename} {
      allow read: if isFinance() || isLoyalisAdmin() ||
        roleIs('satker_head_loyalis') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == employeeId);
      allow create, update: if false;
      allow delete: if false;
    }

    // One optional proof image can accompany a non-driver Pekarya SPJ. It is
    // scoped to the submitting employee before an ActivityReport exists.
    match /activity_proofs/{employeeId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == employeeId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /receipts/{journeyId}/{filename} {
      function journeyExists() {
        return firestore.exists(
          /databases/(default)/documents/DriverJourneys/$(journeyId)
        );
      }

      function journey() {
        return firestore.get(
          /databases/(default)/documents/DriverJourneys/$(journeyId)
        ).data;
      }
      allow read: if journeyExists() &&
        (isFinance() || roleIs('satker_head') ||
          (hasActiveProfile() && journey().get('employeeId', '') == profile().get('linkedEmployeeId', '')));
      allow create, update: if false;
      allow delete: if false;
    }

    // Optional photo attached to a broken-facility report. Scoped to the
    // reporting employee because the photo is uploaded before the
    // FacilityReports document exists.
    match /facility_reports/{employeeId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == employeeId);
      allow create, update: if false;
      allow delete: if false;
    }

    // Optional proof photo captured by a Teknisi/Kebersihan repairer after a
    // facility report has been fixed. The repair API checks the same path
    // ownership before attaching the URL to the report.
    match /facility_report_proofs/{employeeId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == employeeId);
      allow create, update: if false;
      allow delete: if false;
    }

    // Guard-post proof photos. Keyed by the uploading Ketua Shift because the
    // photos are taken while the shift form is still a draft, before the
    // ShiftOccurrence document exists. Kepala SatKer reads them to audit that
    // the pictured guard matches the assignment before releasing the fees.
    match /satpam_shifts/{ketuaShiftId}/{filename} {
      allow read: if isFinance() || roleIs('satker_head') ||
        (hasActiveProfile() && profile().get('linkedEmployeeId', '') == ketuaShiftId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
